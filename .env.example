# ==============================================================================
# Document Delta & Grounded Chat Configuration
# ==============================================================================

# ------------------------------------------------------------------------------
# LLM & Embedding Model Settings (NVIDIA Integrated API / OpenAI Compatible)
# ------------------------------------------------------------------------------
NVIDIA_API_KEY=your-nvidia-api-key-here
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
LLM_MODEL=nvidia/llama-3.3-nemotron-super-49b-v1
EMBEDDING_MODEL=nvidia/llama-nemotron-embed-1b-v2
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=2048

# ------------------------------------------------------------------------------
# Delta Engine Parameters & Thresholds
# ------------------------------------------------------------------------------
TEXT_SIMILARITY_THRESHOLD=0.4
SPATIAL_WEIGHT=0.3
CONFIDENCE_THRESHOLD=0.5
OCR_DPI=300

# ------------------------------------------------------------------------------
# Storage, Telemetry & Logging
# ------------------------------------------------------------------------------
TRACE_OUTPUT_DIR=traces
CHROMA_DB_DIR=.chroma
LOG_LEVEL=INFO

# ------------------------------------------------------------------------------
# Chroma Cloud / Remote Vector Database Settings
# Set CHROMA_USE_CLOUD=true to store and retrieve vectors from Chroma Cloud
# ------------------------------------------------------------------------------
CHROMA_USE_CLOUD=false
CHROMA_CLOUD_API_KEY=your-chroma-cloud-api-key-here
CHROMA_TENANT=default_tenant
CHROMA_DATABASE=default_database
# CHROMA_HOST=your-remote-chroma-host.com
# CHROMA_PORT=8000
